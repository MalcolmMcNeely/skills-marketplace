{
  "uid": "claude-skill-usage",
  "title": "Claude Code skill usage",
  "tags": ["claude-code", "skills"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "skill",
        "label": "Skill (regex)",
        "description": "skill_name is structured metadata, not an index label, so Loki cannot list its values. Type a regex instead.",
        "type": "textbox",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Skill activations",
      "description": "Every time a skill was read into context. Not a measure of whether it helped.",
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "text" }, "unit": "short" },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "claude-loki" },
          "expr": "sum(count_over_time({service_name=\"claude-code\"} | event_name=\"skill_activated\" [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Distinct skills fired",
      "description": "Compare against the catalogue size. The gap is your delete list.",
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 0 },
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "text" }, "unit": "short" },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "claude-loki" },
          "expr": "count(sum by (skill_name) (count_over_time({service_name=\"claude-code\"} | event_name=\"skill_activated\" [$__range])))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "Who chose the skill",
      "description": "claude-proactive means the description worked. user-slash means a developer had to type it. This is the engine versus entry point split. Live events only: a transcript records which skill ran, never why, so backfilled rows carry no trigger and are excluded here rather than guessed at.",
      "gridPos": { "h": 10, "w": 14, "x": 10, "y": 0 },
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.invocation_trigger}"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "claude-loki" },
          "expr": "sum by (invocation_trigger) (count_over_time({service_name=\"claude-code\"} | event_name=\"skill_activated\" | invocation_trigger!=\"\" [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Sessions seen",
      "gridPos": { "h": 5, "w": 10, "x": 0, "y": 5 },
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "text" }, "unit": "short" },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "claude-loki" },
          "expr": "count(sum by (session_id) (count_over_time({service_name=\"claude-code\"} | event_name=\"skill_activated\" [$__range])))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Activations by skill",
      "description": "The ranking. A skill missing from this chart entirely never fired in the window.",
      "gridPos": { "h": 11, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.skill_name}",
          "color": { "mode": "continuous-BlPu" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "claude-loki" },
          "expr": "sort_desc(sum by (skill_name) (count_over_time({service_name=\"claude-code\"} | event_name=\"skill_activated\" | skill_name=~\"$skill\" [$__range])))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Activations by source",
      "description": "plugin means it came from the catalogue. projectSettings means .claude/skills/ in the repo.",
      "gridPos": { "h": 11, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.skill_source}",
          "color": { "mode": "continuous-GrYlRd" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "claude-loki" },
          "expr": "sort_desc(sum by (skill_source) (count_over_time({service_name=\"claude-code\"} | event_name=\"skill_activated\" [$__range])))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Activations by repository",
      "description": "Transcripts carry cwd and git branch, which the OpenTelemetry events do not. Backfilled rows only.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.repo}",
          "color": { "mode": "continuous-BlYlRd" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "claude-loki" },
          "expr": "topk(10, sum by (repo) (count_over_time({service_name=\"claude-code\"} | event_name=\"skill_activated\" | repo!=\"\" | skill_name=~\"$skill\" [$__range])))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Output tokens by skill",
      "description": "Output tokens generated while each skill was the attributed one. A whole request is attributed to whichever skill was active, which is how Claude Code's own cost metric works, so read this as association rather than cause. Cache reads are excluded here because they dominate any total and bill at a fraction.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.skill_name}",
          "color": { "mode": "continuous-GrYlRd" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "claude-loki" },
          "expr": "topk(10, sum by (skill_name) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | skill_name=~\"$skill\" | unwrap output_tokens [$__range])))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Activations over time",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "claude-loki" },
          "expr": "sum by (skill_name) (count_over_time({service_name=\"claude-code\"} | event_name=\"skill_activated\" | skill_name=~\"$skill\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{skill_name}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Raw activations",
      "description": "Expand a line to see every attribute. Live rows carry user.email, which is on by default.",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 39 },
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "claude-loki" },
          "expr": "{service_name=\"claude-code\"} | event_name=\"skill_activated\" | skill_name=~\"$skill\"",
          "queryType": "range"
        }
      ]
    }
  ]
}
